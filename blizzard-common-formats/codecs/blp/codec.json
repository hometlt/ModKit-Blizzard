{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/blp",
  "displayName": "Blizzard BLP texture",
  "status": "partial",
  "runtimeVariants": [
    {
      "entrypoint": "./codecs/blp/runtime.js",
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ],
