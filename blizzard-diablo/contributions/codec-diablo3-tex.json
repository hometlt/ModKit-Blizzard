{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/diablo3-tex",
  "displayName": "Diablo III TEX texture",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/diablo3-tex/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/diablo3-tex/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Validates Diablo III TEX v47 mip and face ranges and decodes A8R8G8B8, A4R4G4B4, L8 and A8 payloads; component-planar BC1, BC2, BC3 and BC5 blocks are reordered and decoded by the shared codec-kit BC decoder (BC5 blue is zero).",
    "The .tex extension is shared with unrelated formats, so hosts must retain the Diablo III magic/version evidence when routing candidates.",
    "Atlas frames are published as the raster source's atlasRegions in mip-0 pixels (the frame table, then the rectangle before mip 0) and cropped with readRegion; texture writing and mip generation remain unsupported.",
    "Mip-table entries past the data the file holds end the mip chain (inspection reports mipTableEntries beside mipLevels); the pixels of every level and format start 16 bytes past its mip-table offset (a rectangle of four floats sits before mip 0), and a cube map stores its faces back to back."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "diablo3-tex",
        "label": "Diablo III TEX texture"
      }
    ],
    "roles": [
      "media"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored",
      "compiled",
      "runtime"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "thumbnail",
      "full",
      "export"
    ],
    "match": {
      "extensions": [
        "tex"
      ],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "efbeadde2f000000"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4096
        }
      ],
      "maxBytes": 4096
    },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/raster-image-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
