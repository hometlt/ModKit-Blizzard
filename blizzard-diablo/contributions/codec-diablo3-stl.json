{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/diablo3-stl",
  "displayName": "Diablo III StringList",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/diablo3-stl/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/diablo3-stl/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Reads StringList v45 (SNO group 42): the entry array at 0x28 of 40-byte entries, each a UTF-8 label and text with its terminating NUL and the djb2 hash of the label bytes taken as signed chars, offsets counted from the SNO data at 0x10 (an empty list stores zeros); a stored hash that is not the label's hash is reported, not repaired.",
    "Text keeps the game's markup verbatim (<Title>, {s1}, [ms]/[fs]/[ns] grammatical forms); it is not rendered or resolved.",
    "Only the installed locale's lists are read; merging locales and writing a StringList are unsupported."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "diablo3-stl",
        "label": "Diablo III StringList"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored",
      "compiled",
      "runtime"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "extensions": [
        "stl"
      ],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "efbeadde2d000000"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4096
        }
      ],
      "maxBytes": 4096
    },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "compiled",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/text-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
