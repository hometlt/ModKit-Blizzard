  "spec": {
    "provides": [
      {
        "offerId": "warcraft3-installation-v1",
        "contract": "common.game/installation-discovery",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "gameIds": [
            "blizzard/warcraft-3"
          ],
          "markers": [
            {
              "gameId": "blizzard/warcraft-3",
              "files": [
                ".build.info",
                "Warcraft III Launcher.exe"
              ]
            },
            {
              "gameId": "blizzard/warcraft-3",
              "files": [
                "war3.mpq",
                "game.dll"
              ]
            },
            {
              "gameId": "blizzard/warcraft-3",
              "files": [
                "war3.mpq",
                "war3.exe"
              ]
            },
            {
              "gameId": "blizzard/warcraft-3",
              "files": [
                "war3.mpq",
                "Warcraft III.exe"
              ]
            },
            {
              "gameId": "blizzard/warcraft-3",
