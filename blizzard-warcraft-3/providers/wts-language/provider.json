{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/service-provider-contribution",
    "major": 1
  },
  "id": "blizzard/war3-wts-language",
  "displayName": "Warcraft III trigger strings language services",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./providers/wts-language/runtime.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    },
    {
      "variantId": "portable",
      "entrypoint": "./providers/wts-language/runtime.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "war3-wts-document-analysis-v1",
        "contract": "common.language/document-analysis",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "languageIds": ["war3-wts"],
          "extensions": ["wts"]
        }
      }
    ],
    "lifecycleScope": "session"
  },
  "limitations": [
    "Reads STRING <n> entries, their comment lines and brace-delimited text; references of a string are the TRIGSTR_<n> it is written as in the JASS documents of the workspace. Uses in the map's binary files (w3i, object data) are not searched yet.",
    "Colours of |cAARRGGBB codes are shown and can be edited; the text is not otherwise validated."
  ]
}
