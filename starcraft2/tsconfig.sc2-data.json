    "modules/data/providers/resolved-data/runtime.js",
    "modules/data/shared/format/index.ts",
    "modules/data/services/catalog/data-session.ts",
    "modules/data/services/catalog/provider.js",
    "modules/data/services/catalog/resolved-data-normalization.js",
    "modules/data/services/catalog/struct-defaults.js",
    "modules/data/services/editing/edit-target.js",
    "modules/data/services/editing/catalog-field-patch.js",
