{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "composite": false, "incremental": true, "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/starcraft2-sc2-cutscene.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": false,
    "isolatedModules": false
  },
  "files": [
    "modules/cutscene/codecs/cutscene/src/codec.ts",
    "modules/cutscene/providers/language/src/language.ts"
  ]
}
