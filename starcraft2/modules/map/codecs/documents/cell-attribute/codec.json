{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-cell-attribute",
  "displayName": "StarCraft II cell attribute layer",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./dist/modules/map/codecs/documents/cell-attribute/src/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./dist/modules/map/codecs/documents/cell-attribute/src/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    }
  ],
  "limitations": [
    "CellAttribute has no self-describing dimensions; standalone inspection stays raw until the caller supplies MapInfo width and height.",
    "Pnp paint is not claimed as fully composed effective navigation."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-cell-attribute",
        "label": "StarCraft II cell attribute layer"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "pathGlobs": [
        "**/CellAttribute_*"
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4
        }
      ],
      "maxBytes": 4
    },
    "representations": [
      {
        "id": "cell-attribute-grid",
        "contract": "common.document/grid",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "blizzard/sc2-cell-attribute.inspect-grid",
        "handlerId": "inspect-grid",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "edit.content",
        "handlerId": "set-cell",
        "mutatesSource": true,
        "requiredPermissions": [
          "read-source",
          "write-source"
        ],
        "outputKinds": [
          "edit-plan"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "traitDeclarations": [
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "content.binary"
      }
    ]
  }
}
