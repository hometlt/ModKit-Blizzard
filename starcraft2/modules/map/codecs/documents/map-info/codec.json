{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-map-info",
  "displayName": "StarCraft II MapInfo",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./dist/modules/map/codecs/documents/map-info/src/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./dist/modules/map/codecs/documents/map-info/src/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    }
  ],
  "limitations": [
    "The fixed header, dimensions, heuristic strings and validated playable boundary are exposed.",
    "MapInfo, MapInfo_LS and MapInfo_NoLS share the versioned binary container. Unqualified body layouts remain opaque. edit.content accepts action=set-editor-terrain-context with expectedContext and context only for the admitted v39 18-byte-prefix fog/context/boundary profile; IDs must be 2–128 ASCII catalog characters. The format owner preserves flags, bounds and every opaque suffix byte; the caller verifies catalog existence."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-map-info",
        "label": "StarCraft II MapInfo"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "pathGlobs": [
        "**/MapInfo",
        "**/MapInfo_LS",
        "**/MapInfo_ls",
        "**/MapInfo_NoLS",
        "**/MapInfo_nols"
      ],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "4970614d"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 24
        }
      ],
      "maxBytes": 24
    },
    "representations": [
      {
        "id": "map-info",
        "contract": "common.document/binary-structure",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "edit.content",
        "handlerId": "set-dimensions",
        "mutatesSource": true,
        "requiredPermissions": [
          "read-source",
          "write-source"
        ],
        "outputKinds": [
          "edit-plan"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "traitDeclarations": [
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "content.binary"
      }
    ]
  }
}
