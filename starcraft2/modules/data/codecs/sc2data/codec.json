{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-data",
  "displayName": "StarCraft II GameData",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./dist/modules/data/codecs/sc2data/src/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./dist/modules/data/codecs/sc2data/src/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    }
  ],
  "limitations": [
    "The native adapter executes the pinned MK2 Catalog parser, metadata, query, inheritance, reference, validation, entity-rename and export implementations.",
    "Entity rename canonically rebuilds affected GameData XML, so formatting and comments in edited files are not preserved.",
    "Override-layer comparison remains explicitly disabled by the pinned codec descriptor."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-data",
        "label": "StarCraft II GameData"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored",
      "compiled",
      "runtime"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "extensions": [
        "xml"
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 65536
        }
      ],
      "maxBytes": 65536
    },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/text-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      },
      {
        "contract": "common.view/subject-facts-source",
        "major": 1
      },
      {
        "contract": "common.view/subject-selector-source",
        "major": 1
      },
      {
        "contract": "common.view/relation-graph-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.search",
        "handlerId": "search",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-data.resolve-inheritance",
        "handlerId": "resolve-inheritance",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-data.references",
        "handlerId": "references",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.compare",
        "handlerId": "compare",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "edit.content",
        "handlerId": "rename-entity",
        "mutatesSource": true,
        "requiredPermissions": [
          "read-source",
          "write-source"
        ],
        "outputKinds": [
          "edit-plan"
        ]
      },
      {
        "id": "export.convert",
        "handlerId": "export-catalog",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes",
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-data.entity-cards",
        "handlerId": "entity-cards",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-data.resolved-view",
        "handlerId": "resolved-view",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "edit.field",
        "handlerId": "edit-field",
        "mutatesSource": true,
        "requiredPermissions": [
          "read-source",
          "write-source"
        ],
        "outputKinds": [
          "edit-plan"
        ]
      },
      {
        "id": "blizzard/sc2-data.filter",
        "handlerId": "filter-entities",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-data.extract",
        "handlerId": "extract-subtree",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "traitDeclarations": [
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "content.text"
      },
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "content.metadata"
      },
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "game.catalog"
      },
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "structure.hierarchy"
      },
      {
        "presence": "will-expose",
        "representation": "source",
        "id": "source.dependencies"
      }
    ]
  }
}
