{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/service-provider-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-data-language",
  "displayName": "StarCraft II GameData language analysis",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./modules/data/providers/language/runtime.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    },
    {
      "variantId": "portable",
      "entrypoint": "./modules/data/providers/language/runtime.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "sc2-data-document-analysis-v1",
        "contract": "common.language/document-analysis",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "languageIds": ["sc2-data"],
          "documentKinds": ["sc2-data-source"],
          "extensions": ["xml"],
          "completionTriggerCharacters": ["<", "\"", "'", " ", "=", ",", ";"],
          "onTypeFormattingTriggerCharacters": ["="]
        }
      }
    ],
    "lifecycleScope": "session"
  }
}
