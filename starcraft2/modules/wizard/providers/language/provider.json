{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/service-provider-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-wizard-language",
  "displayName": "StarCraft II Wizard language analysis",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./modules/wizard/providers/language/runtime.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    },
    {
      "variantId": "portable",
      "entrypoint": "./modules/wizard/providers/language/runtime.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "sc2-wizard-document-analysis-v1",
        "contract": "common.language/document-analysis",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "languageIds": ["sc2-wizard"],
          "documentKinds": ["sc2-wizard-source"],
          "extensions": ["blizwiz"],
          "completionTriggerCharacters": ["<", " ", "\"", "'", "^", ":"]
        }
      }
    ],
    "lifecycleScope": "session"
  }
}
