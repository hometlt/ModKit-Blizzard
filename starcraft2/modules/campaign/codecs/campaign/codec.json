{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-campaign",
  "displayName": "StarCraft II campaign",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./modules/campaign/codecs/campaign/runtime.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./modules/campaign/codecs/campaign/runtime.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Opens MPQ-backed campaigns through the host-owned container alias and uses the same bounded namespace semantics as the loose-directory variant.",
    "Publishes a schemaVersion 1 inventory of nested mission maps, campaign/shared SC2Mod layers, and native CCampaign metadata through tree, table, facts, relations and blizzard/sc2-campaign.inspect-missions.",
    "CampaignData launch maps, bank lists, progress achievements and campaign prerequisites are projected when authored. Installed campaign dependencies are resolved from DocumentInfo plus the engine-defined Core/Liberty/Swarm/Void and Story package graph. CampaignData.xml is edited as a nested blizzard/sc2-campaign-data subject so every write remains bound to the file revision. Mission order implemented by scenario logic and creation of a missing CampaignData.xml namespace entry remain workspace concerns."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-campaign",
        "label": "StarCraft II campaign"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "namespace",
    "artifactStages": [
      "authored",
      "compiled",
      "runtime"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "extensions": [
        "sc2campaign"
      ]
    },
    "probe": {
      "kind": "namespace",
      "markers": [
        "ComponentList.SC2Components",
        "Base.SC2Data",
        "CampaignData",
        "Base.SC2Maps",
        "MapInfo",
        "Objects",
        "Regions"
      ],
      "maxEntries": 7,
      "maxBytes": 65536,
      "maxDepth": 4,
      "maxPathBytes": 4096
    },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/namespace-entry-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/subject-facts-source",
        "major": 1
      },
      {
        "contract": "common.view/relation-graph-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "container.extract",
        "handlerId": "extract-entry",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "blizzard/sc2-campaign.inspect-missions",
        "handlerId": "inspect-missions",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "container": {
      "formatId": "mpq",
      "assetRoots": ["Base.SC2Assets", "*.SC2Assets", ""]
    }
  }
}
