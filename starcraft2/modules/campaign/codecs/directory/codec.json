{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-campaign-directory",
  "displayName": "StarCraft II loose campaign",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./modules/campaign/codecs/directory/runtime.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./modules/campaign/codecs/directory/runtime.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Opens an explicitly mounted loose SC2Campaign directory, publishes its complete bounded namespace, package/bank facts, BankList/Bank/Galaxy relations, and a schemaVersion 1 inventory of nested mission maps, campaign/shared SC2Mod layers, and native CCampaign metadata.",
    "Contained map selection is owned by the StarCraft II workspace and map providers. Installed campaign dependencies are resolved from DocumentInfo plus the engine-defined Core/Liberty/Swarm/Void and Story package graph.",
    "CampaignData launch maps, bank lists, progress achievements and campaign prerequisites are projected when authored. CampaignData.xml is edited as a nested blizzard/sc2-campaign-data subject so every write remains bound to the file revision. Scenario-defined mission order remains explicitly unresolved; creation of a missing CampaignData.xml namespace entry, campaign playback, native signing and launch are not advertised."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-campaign-directory",
        "label": "StarCraft II loose campaign"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "namespace",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {},
    "probe": {
      "kind": "namespace",
      "markers": [
        "ComponentList.SC2Components",
        "Base.SC2Data",
        "Base.SC2Maps",
        "MapInfo",
        "Objects",
        "Regions",
        "t3HeightMap"
      ],
      "maxEntries": 7,
      "maxBytes": 65536,
      "maxDepth": 1,
      "maxPathBytes": 4096
    },
    "representations": [
      {
        "id": "workspace-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/namespace-entry-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/subject-facts-source",
        "major": 1
      },
      {
        "contract": "common.view/relation-graph-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "container.extract",
        "handlerId": "extract-entry",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "blizzard/sc2-campaign-directory.inspect-missions",
        "handlerId": "inspect-missions",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 128,
      "maxNodes": 100000,
      "maxScalarBytes": 134217728,
      "maxDiagnostics": 1000
    }
  }
}
