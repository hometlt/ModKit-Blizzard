{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-layout",
  "displayName": "StarCraft II Layout",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./dist/modules/layout/codecs/layout/src/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./dist/modules/layout/codecs/layout/portable/codec.mjs",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source",
        "write-source"
      ]
    }
  ],
  "limitations": [
    "The native adapter executes the pinned MK2 layout parser, structural renderer, descriptor, raw export, reference rename, schema checker, selector, workspace resolver, state application, expression evaluation, layout solver, display-list builder and HTML renderer.",
    "The protocol-neutral language contribution retains completion, hover, definition, references, safe rename, symbols and diagnostics; the pinned stateful S2LServer remains an LSP compatibility adapter rather than a second host.",
    "Cross-codec rename coordination, automatic installed-archive workspace loading, resolved localization and asset bytes, rasterized game rendering, and installed-editor acceptance remain assigned to M7/M8."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "sc2-layout",
        "label": "StarCraft II Layout"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored",
      "compiled",
      "runtime"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "export"
    ],
    "match": {
      "extensions": [
        "sc2layout"
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4096
        }
      ],
      "maxBytes": 4096
    },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/text-data-source",
        "major": 1
      },
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      },
      {
        "contract": "common.view/subject-facts-source",
        "major": 1
      },
      {
        "contract": "common.view/relation-graph-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "blizzard/sc2-layout.parse",
        "handlerId": "parse",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "blizzard/sc2-layout.resolve",
