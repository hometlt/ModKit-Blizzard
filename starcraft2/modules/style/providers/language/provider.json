{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/service-provider-contribution",
    "major": 1
  },
  "id": "blizzard/sc2-style-language",
  "displayName": "StarCraft II style sheet language analysis",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./modules/style/providers/language/src/provider.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    },
    {
      "variantId": "portable",
      "entrypoint": "./modules/style/providers/language/src/provider.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "sc2-style-document-analysis-v1",
        "contract": "common.language/document-analysis",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "languageIds": [
            "sc2-style"
          ],
          "documentKinds": [
            "sc2-style-source"
          ],
          "extensions": [
            "sc2style"
          ],
          "completionTriggerCharacters": ["<", "\"", "#", " "]
        }
      }
    ],
    "lifecycleScope": "session"
  }
}
