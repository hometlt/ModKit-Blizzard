include "TriggerLibs/NativeLib"
include "LibRuntimeFixture_h"
void libRuntimeFixture_InitLibraries()
{
	libNtve_InitVariables();
}

bool libRuntimeFixture_InitVariables_completed = false;
void libRuntimeFixture_InitVariables()
{
	if (libRuntimeFixture_InitVariables_completed) {
		return;
	}
	libRuntimeFixture_InitVariables_completed = true;
}

void libRuntimeFixture_InitTriggers()
{
}

bool libRuntimeFixture_InitLib_completed = false;
void libRuntimeFixture_InitLib()
{
	if (libRuntimeFixture_InitLib_completed) {
		return;
	}
	libRuntimeFixture_InitLib_completed = true;
	libRuntimeFixture_InitLibraries();
	libRuntimeFixture_InitVariables();
	libRuntimeFixture_InitTriggers();
}
