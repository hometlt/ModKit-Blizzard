{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/starcraft1-grp",
  "displayName": "StarCraft GRP sprite",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/grp/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/grp/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Reads StarCraft GRP sprites (unit, sprite, tileset doodad, cursor and interface GRPs): every frame on the sprite's canvas as one frame of a raster source; run-length coded frames and the plain frames of interface dialogs.",
    "A GRP has no palette: the host binds the *.wpe tileset palettes near the file and the one the palette setting names (a tileset, default badlands) colours it; without one the indices draw in grey. The player-colour remap of indices 8 to 15, the HD sprites (.dds.grp, anim) and writing are later stages."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "starcraft1-grp",
        "label": "StarCraft GRP sprite"
      }
    ],
    "roles": [
      "media"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full"
    ],
    "match": {
      "extensions": [
        "grp"
      ],
      "mediaTypes": [
        "image/x-starcraft-grp"
      ]
    },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/raster-image-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4096
        }
      ],
      "maxBytes": 4096
    }
  }
}
