{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/starcraft1-tileset",
  "displayName": "StarCraft tileset",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/tileset/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/tileset/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Reads a tileset by its tileset/<era>.cv5: the tile groups as a table (group, terrain type, flags, the 16 megatiles) and, with the era's vx4ex or vx4, vr4, vf4 and wpe bound (in a storage's tileset folder, or beside the .cv5 on disk), every megatile as an atlas 32 a row, 32 pixels each, drawn on demand with levels down to one pixel a megatile.",
    "The HD tiles of Remastered (.dds.vr4) and writing a tileset are later stages."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "starcraft1-tileset",
        "label": "StarCraft tileset"
      }
    ],
    "roles": [
      "media"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full"
    ],
    "match": {
      "extensions": [
        "cv5"
      ]
    },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/raster-image-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 64
        }
      ],
      "maxBytes": 64
    }
  }
}
