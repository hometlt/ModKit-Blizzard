{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "blizzard/starcraft1-tbl",
  "displayName": "StarCraft string table",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/tbl/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/tbl/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "limitations": [
    "Reads StarCraft string tables (rez/stat_txt.tbl, the arr/*.tbl tables of the data files): a u16 count, u16 offsets and the strings. An entry is everything up to the next string's offset, split at NULs: the first part is what the game shows, the rest is what stat_txt.tbl keeps for the editors (a unit's group and subgroup).",
    "Control codes (colours, alignment) are shown as <N>, their decimal value. Strings are read as UTF-8 when valid, as Remastered does; other strings are decoded with the textEncoding setting (a WHATWG label, default windows-1252) — the file does not record its code page, so it is not guessed.",
    "Diablo II's .tbl is a different format (a hashed table) and is not read here; writing a table is a later stage."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "starcraft1-tbl",
        "label": "StarCraft string table"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full"
    ],
    "match": {
      "extensions": [
        "tbl"
      ]
    },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4
        }
      ],
      "maxBytes": 4
    }
  }
}
