  "spec": {
    "provides": [
      {
        "offerId": "starcraft1-installation-v1",
        "contract": "common.game/installation-discovery",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "gameIds": [
            "blizzard/starcraft-1"
